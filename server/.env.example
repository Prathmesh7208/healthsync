# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://healthsync:healthsync_password@localhost:5432/healthsync_db?schema=public"

# Redis Connection (BullMQ & Cache)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-for-development-change-in-production"
JWT_EXPIRY="24h"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-for-development-change-in-production"
REFRESH_TOKEN_EXPIRY="30d"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=30

# External Integrations (Optional in Phase 1 / Simulated in dev)
SMS_API_KEY=""
SMS_SENDER_ID="HLTSNC"
MAPS_API_KEY=""

# S3 Storage (Optional in Phase 1 / Local disk storage fallback)
S3_BUCKET="healthsync-records"
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
